# Copy to .env.local and fill in. .env.local is gitignored.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown on contact-form mail. Until you verify your own domain in
# Resend, "onboarding@resend.dev" is the only usable sender, and it can ONLY
# deliver to the email address that owns the Resend account.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# Where contact-form messages are delivered.
CONTACT_TO=

# Public site origin. Feeds canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://bakul.tech

# Optional: search-engine ownership tokens. Paste the content="..." value from
# Google Search Console / Bing Webmaster Tools (HTML tag method). Nothing is
# emitted while these are unset.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
